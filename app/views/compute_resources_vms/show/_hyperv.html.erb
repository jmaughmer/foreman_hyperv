<% title @vm.name %>
<%
  def memory_prop(method)
    content_tag :tr do
      result = content_tag(:td) do
        method.to_s.humanize
      end
      result += content_tag(:td) do
        value = @vm.send(method) rescue nil
        value && number_to_human_size(value)
      end
      result
    end
  end
%>

<div class='col-md-12'>
  <table class="<%= table_css_classes %>">
    <thead>
      <tr><th colspan="2"><%=_('Properties') %></th></tr>
    </thead>
    <tbody>
      <%= prop :name %>
      <%#= prop :cluster %>
      <%= prop :id %>
      <tr>
        <td>Generation</td>
        <td>Generation <%= @vm.generation_num %> (<%= @vm.generation %>)</td>
      </tr>
      <% if @vm.generation == :UEFI %>
        <tr>
          <td>SecureBoot</td>
          <td><%= @vm.firmware.secure_boot %></td>
        </tr>
      <% end %>
      <%= prop :processor_count %>
      <%= memory_prop :memory_startup %>
      <% if @vm.dynamic_memory_enabled %>
        <%= memory_prop :memory_maximum %>
        <%= memory_prop :memory_minimum %>
      <% end %>
      <% @vm.network_adapters.each do |nic| %>
        <tr>
          <td><%= _('NIC') %></td>
          <td><%= nic.name %> - <%= nic.mac %> (<% if nic.connected %><%= nic.switch_name %><% end %>)</td>
        </tr>
      <% end %>
      <% @vm.hard_drives.each do |hdd| %>
        <tr>
          <td><%= _('Disk') %></td>
          <% if hdd.vhd? %>
          <td><%= hdd.name %> - VHD (<%= hdd.vhd.basename %> <%= number_to_human_size(hdd.size_bytes) %>)</td>
          <% else %>
          <td><%= hdd.name %> - Physical (<%= hdd.controller_type %>)</td>
          <% end %>
        </tr>
      <% end %>
      <%= prop :computer_name %>
      <%= prop :state %>
      <%= prop :status %>
      <%= prop :notes %>
      <%# PLG-31: what the cluster will do about this machine — read from the
          same role listing the Registration column joins against, so these
          rows cost no additional cluster round trip. The word is the
          documented meaning, the number in parentheses is what the cluster
          actually answered, and the failback rows appear only when fog has
          the contract to be asked. PLG-31b adds the preferred owners the
          same read now carries — the node names, or the cluster's own "no
          restriction" answer, and never a word a failed read did not earn.
          Display only: the knobs change in Failover Cluster Manager. %>
      <% ha = @compute_resource.cluster_ha_settings(@vm) -%>
      <% if ha.found? -%>
        <tr>
          <td><%= _('Failover priority') %></td>
          <td><%= ha.priority_label %></td>
        </tr>
        <% unless ha.auto_failback_label.nil? -%>
          <tr>
            <td><%= _('Cluster auto failback') %></td>
            <td><%= ha.auto_failback_label %></td>
          </tr>
          <tr>
            <td><%= _('Failback window') %></td>
            <td><%= ha.failback_window_label %></td>
          </tr>
        <% end -%>
        <% unless ha.preferred_owners_label.nil? -%>
          <tr>
            <td><%= _('Preferred owners') %></td>
            <td><%= ha.preferred_owners_label %></td>
          </tr>
        <% end -%>
      <% end -%>
      <tr>
        <td><%= _('Running on') %></td>
        <td><%= link_to @compute_resource, compute_resource_path(@compute_resource) %></td>
      </tr>
    </tbody>
  </table>
</div>
