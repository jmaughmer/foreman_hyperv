<%= javascript_include_tag("foreman_hyperv/compute_resource_base.js") %>
<%
  cluster_errors = []
  begin
    clusters = compute_resource.clusters.map(&:name)
    f.object.cluster_name = clusters.first if clusters.count == 1
    computers = compute_resource.form_computers(f.object.cluster_name)
    f.object.computer_name ||= computers.first.name
  rescue Fog::Hyperv::Errors::PSError => ex
    # In case of errors
    clusters = []
    computers = []

    cluster_errors << ex
  end
-%>
<% if clusters.any? -%>
  <%= select_f f, :cluster_name, clusters, :to_s, :to_s, { include_blank: true }, label: _('Cluster'), disabled: !new_host %>
  <% if computers.count > 1 -%>
    <%= select_f f, :computer_name, computers, :name, :name, {}, label: _('Computer Name'), disabled: !new_host, onload: 'hypervHostChange(this);', onchange: 'hypervHostChange(this);' %>
  <% end -%>
  <%# PLG-30: create-only. Failback is a property of the cluster role, and this
      is the one HA setting the cluster takes as a write (fog evidence §60): it
      is applied once, after the role add is proven, and the Registration
      column then shows whatever the cluster reports. The edit form leaves it
      alone — the column is where the cluster's answer is read. -%>
  <%= checkbox_f f, :auto_failback, { help_inline: _('After the machine joins the cluster, turn on automatic failback for it. The instance list shows what the cluster reports.'),
                                      label: _('Automatic failback'),
                                      label_size: 'col-md-2' }, 'true', 'false' if new_host -%>
  <%
    # PLG-36: the OTHER owner-list surface, and the mirror image of the above:
    # preferred owners are edited on the EDIT form (the create path has no role
    # to put them on yet). cluster_preferred_owners_for answers the whole
    # honesty question — a stand-alone endpoint, a fog without the write, a
    # machine without a role, and a failed owner read all answer nil, and each
    # of them renders no control rather than a selection the page cannot claim
    # to show. The current list pre-selects; Rails' multiple-select hidden
    # field makes the empty submission an explicit clear, which save_vm only
    # acts on when it differs from the cluster's answer. The options are the
    # cluster's own node names.
    preferred_owners = new_host ? nil : compute_resource.cluster_preferred_owners_for(f.object)
    owner_node_choices = preferred_owners.nil? ? nil : compute_resource.cluster_node_names
  -%>
  <% unless preferred_owners.nil? || owner_node_choices.nil? -%>
    <%= select_f f, :preferred_owners, owner_node_choices, :to_s, :to_s,
                 { :selected => preferred_owners },
                 { :multiple => true, label: _('Preferred owners'), label_size: 'col-md-2',
                   help_inline: _('Nodes the cluster may run this machine on. Leave the list empty to allow any node; the instance list shows what the cluster reports.') } -%>
  <% end -%>
<% end -%>
<% cluster_errors.each do |err| -%>
<div class="alert alert-warning alert-dismissable">
  <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
  <span class="pficon pficon-error-circle-o "></span> <span class="text"><%= err.message %> (<%= err.info %>)</span>
</div>
<% end -%>

<%
  firmware_type = compute_resource.firmware_type(f.object.foreman_firmware, f.object.secure_boot_enabled)
-%>
<%= field(f, :foreman_firmware, :label => _('Firmware'), :label_help => _("Choose 'Automatic' to set the firmware based on the PXE loader of the host. If no PXE loader is selected, firmware defaults to BIOS."), :label_size => "col-md-2") do
  compute_resource.firmware_types.collect do |type, name|
    enabled = new_vm
    enabled ||= firmware_type != 'bios' && type.to_s.start_with?('uefi')

    radio_button_f f, :foreman_firmware, { :checked => (firmware_type == type), :disabled => !enabled, :value => type, :text => _(name) }
  end.join(' ').html_safe
end %>
<%= checkbox_f f, :tpm_enabled, { help_inline: _('Add Virtual TPM module to the VM.'),
                                  label: _('Virtual TPM'),
                                  label_help: _('Only compatible with UEFI firmware.'),
                                  label_size: 'col-md-2' } %>
<%= select_f f, :boot_device, hyperv_boot_devices, :first, :last, {}, label: _('Boot device'), label_help: _('Has effect only for network based provisioning'), class: 'col-md-2' if new_vm %>

<%= counter_f f, :processor_count, label: _('CPUs'), label_size: 'col-md-2' %>
<%= byte_size_f f, :memory_startup, label: _('Memory (Startup)'), label_size: 'col-md-2' %>

<%= checkbox_f f, :dynamic_memory_enabled, { label: _('Use Dynamic Memory'), onchange: 'hypervDynamicMemoryChange(this);' }, 'true', 'false' %>
<%= byte_size_f f, :memory_maximum, class: 'col-md-2', label: _('Memory Maximum'), disabled: !f.object.dynamic_memory_enabled %>
<%= byte_size_f f, :memory_minimum, class: 'col-md-2', label: _('Memory Minimum'), disabled: !f.object.dynamic_memory_enabled %>

<% checked = params[:host] && params[:host][:compute_attributes] && params[:host][:compute_attributes][:start] || '1' -%>
<%= checkbox_f f, :start, { checked: (checked == '1'), help_inline: _("Power ON this machine"), label: _('Start'), label_size: "col-md-2"} if new_host && controller_name != "compute_attributes" %>

<%= textarea_f f, :notes, rows: '3', label: _('Notes') %>
