<%= text_f f, :url, label: _('WinRM Endpoint'), help_block: _('e.g. http://host.example.com:5985/wsman')%>
<%= text_f f, :user, label: _('User') %>
<%= password_f f, :password, label: _('Password') %>

<%# PLG-32: the transport controls the plugin already honored but only the API
    could reach. Verification stays ON by default — the (w) matrix measured
    https as trustable only against an explicit CA file — and switching it off
    is the operator's deliberate choice, which is exactly what the checkbox
    makes explicit. %>
<%= checkbox_f f, :hyperv_ssl_verify, label: _('Verify SSL certificate'),
               help_block: _('On (the default) an https endpoint is accepted only when its certificate verifies. Off is a deliberate opt-out: the certificate is not checked, and https composes for any endpoint identity, including an IPv4 one. Ignored on http endpoints.') %>
<%= text_f f, :hyperv_ca_trust_path, label: _('CA trust file path'),
           help_block: _('Absolute path, on the Foreman server, to a CA certificate file that https endpoints are verified against (a bare absolute path or nothing at all — anything else is refused on save).') %>
<%= textarea_f f, :hyperv_node_overrides, label: _('Cluster node endpoint overrides'),
               help_block: _('One NODE = host[:port] line per cluster node this endpoint does not serve. The value is a bare host or host:port — the scheme and port come from the WinRM endpoint above.') %>

<%# PLG-34: the opt-in to keepalive. The first read after an idle gap pays a
    cold WinRM shell (measured 20-120 s per node); a tick replays one page
    load of reads so a human never pays it. Off by default: the plugin does
    not dial a node nobody asked it to keep warm. %>
<%= checkbox_f f, :hyperv_keepalive, label: _('Keep connections warm'),
               help_block: _('On: Foreman periodically replays one listing of endpoint reads against this resource (interval: the Hyper-V keepalive setting, default 5 minutes), so the next page load never pays a cold WinRM shell. Off (the default): nothing dials these nodes until a human asks.') %>

<%# Currently not working due to marshaling errors %>
<%#= checkbox_f f, :caching_enabled, :label => _("Enable Caching"),
                  :help_inline => _("Cache slow calls to Hyper-V to speed up page rendering") %>

<div class="col-md-offset-2">
  <%= test_connection_button_f(f, f.object.connection_valid?) %>
</div>
